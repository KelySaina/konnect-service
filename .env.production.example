# ============================================================
# Konnect — Production Environment
# ============================================================
# Copy this file to .env and fill in real values.
# Generate secrets: openssl rand -hex 32
# ============================================================

# Server
NODE_ENV=production
API_PORT=7300
API_URL=https://auth.example.com
CLIENT_URL=https://auth.example.com

# Database (internal Docker network — no external port needed)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=konnect
DB_USER=konnect
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Redis (internal Docker network)
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO (internal Docker network)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
MINIO_BUCKET=konnect-files
MINIO_USE_SSL=false

# JWT
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800
JWT_ISSUER=https://auth.example.com

# OAuth2
OAUTH_AUTH_CODE_TTL=600

# Session
SESSION_SECRET=CHANGE_ME_SESSION_SECRET

# Admin (initial seed only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
