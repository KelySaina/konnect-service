# Server
NODE_ENV=development
API_PORT=7300
API_URL=http://localhost:7300
CLIENT_URL=http://localhost:7517

# Database
DB_HOST=localhost
DB_PORT=7543
DB_NAME=konnect
DB_USER=konnect
DB_PASSWORD=konnect_secret

# Redis
REDIS_HOST=localhost
REDIS_PORT=7637

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=7900
MINIO_CONSOLE_PORT=7901
MINIO_ACCESS_KEY=konnect_minio
MINIO_SECRET_KEY=konnect_minio_secret
MINIO_BUCKET=konnect-files
MINIO_USE_SSL=false

# JWT — keys are auto-generated in ./keys/ on first run
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800
JWT_ISSUER=http://localhost:7300

# OAuth2
OAUTH_AUTH_CODE_TTL=600

# Session secret for consent screen
SESSION_SECRET=change-me-in-production

# First admin account (created on seed)
ADMIN_EMAIL=admin@konnect.local
ADMIN_PASSWORD=Admin123!
